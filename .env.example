# Required: your Google Gemini API key - free tier, no credit card required.
# Get one at https://aistudio.google.com/ -> "Get API key"
GEMINI_API_KEY=AIza...

# Model used for the agent's reasoning/tool-use loop
AGENT_MODEL=gemini-flash-lite-latest

# Set to 1 the first time you run, or whenever you want to wipe the AP system's
# database and start demo scenarios fresh (undoes previously recorded invoices and
# resets the "first submission attempt fails" simulated-flakiness counters).
RESET_DB=0

# Internal app URLs (defaults match run.sh; only change if you edit the ports there)
VENDOR_MAIL_URL=http://127.0.0.1:5001
AP_SYSTEM_URL=http://127.0.0.1:5002
VENDOR_MAIL_PORT=5001
AP_SYSTEM_PORT=5002
DASHBOARD_PORT=5000

# Credentials the agent is told it may use to log into the internal AP system
AP_SYSTEM_USERNAME=ap_agent
AP_SYSTEM_PASSWORD=CentrAlign#2026
AP_SYSTEM_SECRET=dev-secret-not-for-production

# Set to false to watch the browser window live instead of running headless
BROWSER_HEADLESS=true

# Safety cap on how many tool-call steps the agent may take before being forced to stop
AGENT_MAX_STEPS=40
